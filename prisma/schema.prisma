generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_SUPER_ADMIN
  SUPER_ADMIN
  ADMIN
  SYNDICATE_REP
  READ_ONLY
  UNDERWRITER
}

enum DealStatus {
  PENDING_REVIEW
  OPEN_FOR_SYNDICATION
  FULLY_ALLOCATED
  FUNDED
  ACTIVE_REPAYING
  DELINQUENT
  DEFAULTED
  PAID_OFF
  CLOSED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  DENIED
}

enum EmailStatus {
  UNPROCESSED
  PARSED
  REVIEW_NEEDED
  DEAL_CREATED
  REJECTED
  ERROR
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  DEAL_CREATED
  DEAL_UPDATED
  DEAL_STATUS_CHANGED
  DEAL_PUBLISHED
  SYNDICATION_COMMITTED
  SYNDICATION_CANCELLED
  PAYMENT_POSTED
  PAYMENT_UPDATED
  PAYMENT_REVERSED
  PAYOUT_REQUESTED
  PAYOUT_APPROVED
  PAYOUT_DENIED
  PAYOUT_COMPLETED
  BANK_ACCOUNT_LINKED
  BANK_ACCOUNT_REMOVED
  EMAIL_PARSED
  SETTINGS_UPDATED
  UW_APP_CREATED
  UW_APP_UPDATED
  UW_DOC_UPLOADED
  UW_BANK_LINKED
  UW_ANALYSIS_RUN
  UW_VENDOR_PULL
  UW_DECISION_MADE
  UW_TAMPER_CHECK
}

enum TamperVerdict {
  CLEAN
  SUSPICIOUS
  TAMPERED
  UNKNOWN
}

enum UwAppStatus {
  INTAKE
  DOCS_PENDING
  ANALYZING
  UNDER_REVIEW
  APPROVED
  DECLINED
  WITHDRAWN
}

enum PaperGrade {
  A
  B
  C
  D
  UNGRADED
}

enum UwDocType {
  BANK_STATEMENT
  ID_FRONT
  ID_BACK
  VOIDED_CHECK
  APPLICATION
  EIN_LETTER
  ARTICLES
  LEASE
  PROCESSING_STATEMENT
  PAYOFF_LETTER
  TAX_RETURN
  OTHER
}

// ============================================================
// MODELS
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole  @default(SYNDICATE_REP)
  isActive      Boolean   @default(true)
  isHidden      Boolean   @default(false)
  phone         String?
  avatarUrl     String?
  lastLoginAt   DateTime?

  // MFA
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?   // Encrypted TOTP secret
  mfaRecoveryCodes String?   // JSON array of hashed recovery codes
  mfaVerifiedAt    DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  syndications    Syndication[]
  payoutRequests  PayoutRequest[]     @relation("PayoutRequester")
  bankAccounts    BankAccount[]
  auditLogs       AuditLog[]          @relation("AuditActor")
  auditTargets    AuditLog[]          @relation("AuditTarget")
  createdDeals    Deal[]              @relation("DealCreator")
  reviewedDeals   Deal[]              @relation("DealReviewer")
  postedPayments  Payment[]           @relation("PaymentPoster")
  approvedPayouts PayoutRequest[]     @relation("PayoutApprover")
  notifications   Notification[]

  uwAppsCreated   UwApplication[]     @relation("UwAppCreatedBy")
  uwAppsAssigned  UwApplication[]     @relation("UwAppAssignedTo")
  uwDocsUploaded  UwDocument[]        @relation("UwDocUploader")
  uwDecisions     UwDecision[]        @relation("UwDecisionMaker")

  @@map("users")
}

model Deal {
  id                 String     @id @default(cuid())

  // Merchant Info
  merchantName       String
  merchantDba        String?
  merchantIndustry   String?
  merchantState      String?

  // Deal Terms
  fundedAmount       Decimal    @db.Decimal(12, 2)
  paybackAmount      Decimal    @db.Decimal(12, 2)
  factorRate         Decimal    @db.Decimal(6, 4)
  holdbackPercentage Decimal?   @db.Decimal(5, 2)
  termDays           Int?
  paymentFrequency   String?    @default("daily")
  expectedPayments   Int?

  // Syndication Config
  syndicationMin     Decimal    @db.Decimal(12, 2) @default(100.00)
  syndicationMax     Decimal?   @db.Decimal(12, 2)
  syndicationOpen    Decimal    @db.Decimal(12, 2)

  // Status & Lifecycle
  status             DealStatus @default(PENDING_REVIEW)
  statusChangedAt    DateTime   @default(now())
  fundedAt           DateTime?
  firstPaymentAt     DateTime?
  lastPaymentAt      DateTime?
  closedAt           DateTime?

  // Tracking
  totalCollected     Decimal    @db.Decimal(12, 2) @default(0.00)
  missedPayments     Int        @default(0)

  // Source
  sourceEmailId      String?
  sourceEmail        IngestedEmail? @relation(fields: [sourceEmailId], references: [id])

  // Admin
  createdById        String?
  createdBy          User?      @relation("DealCreator", fields: [createdById], references: [id])
  reviewedById       String?
  reviewedBy         User?      @relation("DealReviewer", fields: [reviewedById], references: [id])
  notes              String?    @db.Text
  internalNotes      String?    @db.Text

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  syndications       Syndication[]
  payments           Payment[]

  @@index([status])
  @@index([merchantName])
  @@index([createdAt])
  @@map("deals")
}

model Syndication {
  id                String   @id @default(cuid())

  dealId            String
  deal              Deal     @relation(fields: [dealId], references: [id])
  userId            String
  user              User     @relation(fields: [userId], references: [id])

  amount            Decimal  @db.Decimal(12, 2)
  ownershipPct      Decimal  @db.Decimal(7, 4)

  // Running totals (updated on each payment distribution)
  principalReturned Decimal  @db.Decimal(12, 2) @default(0.00)
  profitEarned      Decimal  @db.Decimal(12, 2) @default(0.00)
  totalDistributed  Decimal  @db.Decimal(12, 2) @default(0.00)

  isActive          Boolean  @default(true)
  committedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  distributions     Distribution[]

  @@unique([dealId, userId])
  @@index([userId])
  @@index([dealId])
  @@map("syndications")
}

model Payment {
  id             String   @id @default(cuid())

  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id])

  amount         Decimal  @db.Decimal(12, 2)
  paymentDate    DateTime
  paymentNumber  Int
  memo           String?
  idempotencyKey String?  @unique  // Prevents duplicate submissions

  postedById     String
  postedBy       User     @relation("PaymentPoster", fields: [postedById], references: [id])

  isReversed     Boolean  @default(false)
  reversedAt     DateTime?
  reversalReason String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  distributions  Distribution[]

  @@index([dealId])
  @@index([paymentDate])
  @@map("payments")
}

model Distribution {
  id               String      @id @default(cuid())

  paymentId        String
  payment          Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  syndicationId    String
  syndication      Syndication @relation(fields: [syndicationId], references: [id])

  amount           Decimal     @db.Decimal(12, 2)
  principalPortion Decimal     @db.Decimal(12, 2)
  profitPortion    Decimal     @db.Decimal(12, 2)

  createdAt        DateTime    @default(now())

  @@index([syndicationId])
  @@index([paymentId])
  @@map("distributions")
}

model PayoutRequest {
  id             String       @id @default(cuid())

  userId         String
  user           User         @relation("PayoutRequester", fields: [userId], references: [id])

  amount         Decimal      @db.Decimal(12, 2)
  bankAccountId  String?
  bankAccount    BankAccount? @relation(fields: [bankAccountId], references: [id])

  status         PayoutStatus @default(PENDING)

  approvedById   String?
  approvedBy     User?        @relation("PayoutApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  processedAt    DateTime?
  completedAt    DateTime?
  deniedAt       DateTime?
  denialReason   String?

  notes          String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payout_requests")
}

model BankAccount {
  id                String          @id @default(cuid())

  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  plaidAccessToken  String
  plaidAccountId    String
  plaidItemId       String

  institutionName   String
  accountName       String
  accountMask       String
  accountType       String
  accountSubtype    String?

  isDefault         Boolean         @default(false)
  isActive          Boolean         @default(true)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  payoutRequests    PayoutRequest[]

  @@index([userId])
  @@map("bank_accounts")
}

model IngestedEmail {
  id             String      @id @default(cuid())

  messageId      String      @unique
  fromAddress    String
  subject        String
  receivedAt     DateTime
  rawBody        String      @db.Text
  htmlBody       String?     @db.Text

  parsedMerchant String?
  parsedAmount   Decimal?    @db.Decimal(12, 2)
  parsedPayback  Decimal?    @db.Decimal(12, 2)
  parsedFactor   Decimal?    @db.Decimal(6, 4)
  parsedData     Json?

  status         EmailStatus @default(UNPROCESSED)
  parseError     String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  deals          Deal[]

  @@index([status])
  @@index([receivedAt])
  @@map("ingested_emails")
}

model AuditLog {
  id           String      @id @default(cuid())

  action       AuditAction
  actorId      String?
  actor        User?       @relation("AuditActor", fields: [actorId], references: [id])
  targetUserId String?
  targetUser   User?       @relation("AuditTarget", fields: [targetUserId], references: [id])

  resourceType String?
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?

  createdAt    DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// ============================================================
// UNDERWRITING (MCA) MODELS
// ============================================================

model UwApplication {
  id          String      @id @default(cuid())
  status      UwAppStatus @default(INTAKE)
  paperGrade  PaperGrade  @default(UNGRADED)
  publicToken String      @unique

  // Business
  legalName            String
  dba                  String?
  ein                  String?
  entityType           String?
  naics                String?
  state                String?
  businessPhone        String?
  businessEmail        String?
  businessAddress      String?
  timeInBusinessMonths Int?
  requestedAmount      Decimal? @db.Decimal(12, 2)
  useOfFunds           String?
  monthlyRevenueClaim  Decimal? @db.Decimal(12, 2)

  // Workflow
  createdById  String
  createdBy    User      @relation("UwAppCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation("UwAppAssignedTo", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owners       UwOwner[]
  documents    UwDocument[]
  bankAnalyses UwBankAnalysis[]
  vendorPulls  UwVendorPull[]
  decisions    UwDecision[]

  @@index([status])
  @@index([paperGrade])
  @@index([createdAt])
  @@map("uw_applications")
}

model UwOwner {
  id            String   @id @default(cuid())
  applicationId String
  application   UwApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String
  ssnEnc       String?
  dob          DateTime?
  ownershipPct Decimal  @db.Decimal(5, 2)
  phone        String?
  email        String?
  homeAddress  String?
  ficoClaim    Int?

  pgConsent   Boolean   @default(false)
  pgConsentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@map("uw_owners")
}

model UwDocument {
  id            String   @id @default(cuid())
  applicationId String
  application   UwApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  docType        UwDocType
  s3Key          String
  filename       String
  contentType    String
  sizeBytes      Int
  statementMonth Int?
  statementYear  Int?

  uploadedById String?
  uploadedBy   User?    @relation("UwDocUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  tamperChecks UwTamperCheck[]

  @@index([applicationId])
  @@index([docType])
  @@map("uw_documents")
}

model UwTamperCheck {
  id          String         @id @default(cuid())
  documentId  String
  document    UwDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  source      String                                    // "pdf_inspector" | "inscribe"
  verdict     TamperVerdict  @default(UNKNOWN)
  riskScore   Int                                       // 0 (clean) – 100 (definitely tampered)
  signals     Json                                      // array of typed signal objects
  rawJson     Json?
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([documentId, source])
  @@map("uw_tamper_checks")
}

model UwBankAnalysis {
  id            String   @id @default(cuid())
  applicationId String
  application   UwApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  source      String
  periodStart DateTime
  periodEnd   DateTime
  metricsJson Json
  rawJson     Json?

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@map("uw_bank_analyses")
}

model UwVendorPull {
  id            String   @id @default(cuid())
  applicationId String
  application   UwApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  vendor       String
  status       String
  resultJson   Json?
  errorMessage String?
  cost         Decimal? @db.Decimal(8, 4)
  pulledAt     DateTime @default(now())

  @@index([applicationId, vendor])
  @@map("uw_vendor_pulls")
}

model UwDecision {
  id            String   @id @default(cuid())
  applicationId String
  application   UwApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  decidedById   String
  decidedBy     User       @relation("UwDecisionMaker", fields: [decidedById], references: [id])

  decision      String
  paperGrade    PaperGrade
  notes         String?    @db.Text
  riskFlagsJson Json?

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@map("uw_decisions")
}
